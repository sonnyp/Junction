using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow window {
  title: "Junction";
  hide-on-close: true;
  styles ["welcome"]

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [start]
      Button {
        action-name: "app.about";
        icon-name: "help-about-symbolic";
        tooltip-text: _("About Junction");
      }
    }

    Box content_box {
      name: "content";
      orientation: vertical;
      valign: center;
      halign: center;
      vexpand: true;
      hexpand: true;
      spacing: 14;

      Image {
        icon-name: "re.sonny.Junction";
        pixel-size: 128;
      }

      LinkButton test_link {
        label: _("Test Junction");
        valign: center;
        halign: center;
        uri: "https://junction.sonny.re/demo";
      }

      Box {
        halign: center;
        spacing: 12;

        Label {
          label: _("Compact Mode");
          valign: center;
        }

        Switch compact_switch {
          valign: center;
        }
      }

      Box {
        halign: center;
        spacing: 12;

        Label {
          label: _("Tray Icon");
          valign: center;
        }

        Switch tray_switch {
          valign: center;
        }
      }

      Button {
        label: _("URL Rules");
        valign: center;
        halign: center;
        action-name: "app.preferences";
      }

      Button {
        label: _("Arrange Applications");
        valign: center;
        halign: center;
        clicked => $onApplications();
      }

      Button {
        label: _("Set Junction as default for Web");
        valign: center;
        halign: center;
        clicked => $onInstall();
      }
    }
  };
}
