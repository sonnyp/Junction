using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow window {
  default-width: 772;
  width-request: 360;
  styles ["main"]

  // portrait
  Adw.Breakpoint {
    condition ("max-aspect-ratio: 1")
    setters {
      list.halign: fill;
      list.valign: end;
      window_controls_bottom.visible: false;
      button_menu_bottom.visible: false;
      toolbar_view.reveal-top-bars: true;
    }
  }

  content: Adw.ToolbarView toolbar_view {
    reveal-top-bars: false;

    [top]
    Adw.HeaderBar header_bar {
      [start]
      MenuButton button_menu_top {
        menu-model: menu_model;
        icon-name: "open-menu-symbolic";
        tooltip-text: _("Main Menu");
        valign: center;
        primary: true;
        styles ["circular", "flat"]
      }

    }

    content: WindowHandle {
      ScrolledWindow {
        vexpand: true;
        propagate-natural-height: true;
        hscrollbar-policy: never;
        FlowBox list {
          halign: center;
          valign: center;
          max-children-per-line: 5;
          min-children-per-line: 3;
          homogeneous: true;
          styles ["list"]
          column-spacing: 12;
          row-spacing: 12;
          selection-mode: none;
          activate-on-single-click: true;
        }
      }
    };

    [bottom]
    Box {
      spacing: 12;
      styles ["bar"]

      MenuButton button_menu_bottom {
        menu-model: menu_model;
        icon-name: "open-menu-symbolic";
        tooltip-text: _("Main Menu");
        valign: center;
        primary: true;
        styles ["circular", "flat"]
      }

      Entry entry {
        hexpand: true;
        input-purpose: url;
        xalign: 0.5;
        styles ["uri"]
      }

      Button {
        action-name: "win.add-rule";
        icon-name: "list-add-symbolic";
        tooltip-text: _("Add URL Rule for This Site");
        valign: center;
        styles ["circular", "flat"]
      }

      WindowControls window_controls_bottom {
        decoration-layout: "close";
      }
    }
  };
}

menu menu_model {
  section {
    item {
      custom: "themeswitcher";
    }
  }

  section {
    item {
      label: _("Show App Names");
      action: "win.show-app-names";
    }

    item {
      label: _("Compact Mode");
      action: "win.compact";
    }

    item {
      label: _("Show Tray Icon");
      action: "win.show-tray";
    }

    item {
      label: _("Arrange Applications…");
      action: "win.reorder";
    }

    item {
      label: _("Copy to Clipboard");
      action: "win.copy";
    }
  }

  section {
    item {
      label: _("URL Rules");
      action: "app.preferences";
    }

    item {
      label: _("Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("About Junction");
      action: "app.about";
    }
  }
}
